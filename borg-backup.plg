<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name       "borg-backup">
<!ENTITY author     "macmillernz">
<!ENTITY version    "2026.11.17a">
<!ENTITY pkgMD5     "74ab226c94c8e7e4ec49cfc583a638ee">
<!ENTITY gitURL     "https://raw.githubusercontent.com/macmillernz/borg-backup/main">
<!ENTITY pluginURL  "&gitURL;/&name;.plg">
<!ENTITY plgPATH    "/boot/config/plugins/&name;">
<!ENTITY borgVER    "1.4.5">
<!ENTITY borgSHA256 "c8457f70660064d0f45b38283ab4cc65b342970012013201d3aec713a75898fb">
<!ENTITY borgURL    "https://github.com/borgbackup/borg/releases/download/&borgVER;/borg-linux-glibc231-x86_64">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="Backup"
        pluginURL="&pluginURL;"
        support="https://github.com/macmillernz/borg-backup/issues"
        icon="archive"
        min="6.12.0">

<CHANGES>
###2026.11.17a
- New repository: the location is checked as you type. Folder suggestions (arrow keys, Enter or Tab;
  Tab completes like a shell), and a status line saying whether it is an existing Borg repository, an empty or new folder, the free
  space, and a warning for paths in RAM or on the flash drive. New vs. existing is detected automatically
  for local paths.

###2026.11.16d
- The top-menu entry is now labelled exactly "Backup" (it showed "BorgBackup"); the page lives at /Backup.

###2026.11.16c
- Borg Backup now has its own Backup tab in the top menu, right of Tools (moved from Settings > Utilities).

###2026.11.16b
- Wizard: when several selected mounts live in the same app folder (e.g. /mnt/user/appdata/authentik),
  offer to back up that one folder instead, showing anything else the folder contains. Undo is one click.
- Backups skip a selected path that is already inside another selected path, so nothing is archived twice.

###2026.11.16a
- Remove the "setlocale: C.UTF-8" warning from script logs (Unraid has no C.UTF-8 locale).

###2026.11.16
- Fix updates not replacing the plugin files (pages stayed blank after updating to 2026.11.15a).
  The installer now verifies the installed version and extracts the package directly if needed.

###2026.11.15a
- Fix blank pages on Unraid 7.4: API requests are now sent URL-encoded (multipart POSTs stalled).
- Show an error message on the pages when the backend cannot be reached instead of staying blank.

###2026.11.15
- Initial release: Dashboard, Jobs, Repositories, Restore, Tests, Scripts and Settings.
- Job wizard for containers, compose stacks and custom paths with automatic mount detection.
</CHANGES>

<!-- Borg standalone binary (official release, checksum verified) -->
<FILE Name="&plgPATH;/borg-&borgVER;">
<URL>&borgURL;</URL>
<SHA256>&borgSHA256;</SHA256>
</FILE>

<!-- Plugin package -->
<FILE Name="&plgPATH;/&name;-&version;-x86_64-1.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/archive/&name;-&version;-x86_64-1.txz</URL>
<MD5>&pkgMD5;</MD5>
</FILE>

<!-- Post install -->
<FILE Run="/bin/bash">
<INLINE>
set -e
PLG="&plgPATH;"
DIR="/usr/local/emhttp/plugins/&name;"
PKG="$PLG/&name;-&version;-x86_64-1.txz"
# upgradepkg sometimes leaves the previous files in place on Unraid; the package
# carries a VERSION file, so verify it and fall back to extracting directly.
if [ "$(cat "$DIR/VERSION" 2>/dev/null)" != "&version;" ]; then
  echo "Package manager did not update the plugin files - extracting the package directly."
  rm -rf "$DIR"
  tar -xJf "$PKG" -C /
fi
if [ "$(cat "$DIR/VERSION" 2>/dev/null)" != "&version;" ]; then
  echo "ERROR: plugin files could not be installed from $PKG"
  exit 1
fi
# the menu page was renamed in 2026.11.16d; remove the old one if the package manager left it
rm -f "$DIR/BorgBackup.page"
# install borg unless an identical binary is already there
if ! cmp -s "$PLG/borg-&borgVER;" /usr/local/bin/borg 2>/dev/null; then
  install -m 0755 "$PLG/borg-&borgVER;" /usr/local/bin/borg
fi
# remove old package/binary versions from the flash drive
find "$PLG" -maxdepth 1 -name '&name;-*.txz' ! -name '&name;-&version;-x86_64-1.txz' -delete 2>/dev/null || true
find "$PLG" -maxdepth 1 -name 'borg-[0-9]*' ! -name 'borg-&borgVER;' -delete 2>/dev/null || true
mkdir -p "$PLG/scripts" "$PLG/ssh" "$PLG/borg"
chmod 0755 /usr/local/emhttp/plugins/&name;/include/runner.php
# re-register schedules (the cron file lives on the flash drive)
[ -f "$PLG/&name;.cron" ] &amp;&amp; /usr/local/sbin/update_cron
echo ""
echo "----------------------------------------------------"
echo " Borg Backup &version; installed ($(/usr/local/bin/borg --version 2>/dev/null))"
echo " Open it from the Backup tab in the top menu"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Removal: jobs, repository settings (incl. passphrases), scripts and SSH keys
     in /boot/config/plugins/borg-backup are kept on purpose. -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLG="&plgPATH;"
for f in /var/run/borg-backup/tasks/*.json; do
  [ -f "$f" ] || continue
  pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$f")
  [ -n "$pid" ] &amp;&amp; kill "$pid" 2>/dev/null
done
rm -f "$PLG/&name;.cron"
/usr/local/sbin/update_cron
removepkg &name; 2>/dev/null
rm -rf /usr/local/emhttp/plugins/&name; /var/run/borg-backup /tmp/borg-backup
cmp -s /usr/local/bin/borg "$PLG/borg-&borgVER;" 2>/dev/null &amp;&amp; rm -f /usr/local/bin/borg
rm -f "$PLG"/&name;-*.txz "$PLG"/borg-[0-9]*
echo "Borg Backup removed. Your configuration in $PLG was kept."
</INLINE>
</FILE>

</PLUGIN>
